# GreyWater Guardian Environment Configuration
# Copy this file to .env or backend/.env

# Backend Server Port
PORT=5000

# Device Authentication Key for ESP32 Telemetry
DEVICE_API_KEY=gw-esp32-secret-2026

# MySQL Database Configuration
# (If MySQL is unreachable, the system automatically runs with its built-in in-memory repository)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=greywater_guardian

# Environment
NODE_ENV=development
